<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Public, disposable fixture credentials. Environment overrides use the same keys. -->
    <add key="FAKE_LDAP_HOST" value="127.0.0.1" />
    <add key="FAKE_LDAP_PORT" value="1389" />
    <add key="FAKE_LDAP_BASE_DN" value="dc=example,dc=test" />
    <add key="FAKE_LDAP_BIND_DN" value="cn=admin,dc=example,dc=test" />
    <add key="FAKE_LDAP_PASSWORD" value="FakeLegacyOnly!1" />
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <customErrors mode="RemoteOnly" />
    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="Static" />
  </system.web>
</configuration>
